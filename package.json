{
  "name": "jest-supertest-rbac-api-tests",
  "version": "1.0.0",
  "description": "A black-box Jest + Supertest API test suite against the rbac-healthcare-system backend, written to accompany the API Testing using TypeScript course.",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke": "jest --testNamePattern=\"@smoke\"",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.17.1",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
